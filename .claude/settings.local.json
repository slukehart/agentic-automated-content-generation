{
  "permissions": {
    "allow": [
      "WebFetch(domain:www.whytryai.com)",
      "Bash(git add:*)",
      "Bash(bash .claude/hooks/session-start-vault-check.sh)",
      "Bash(echo \"EXIT: $?\")",
      "Bash(git push:*)",
      "Bash(go build *)",
      "Bash(echo \"exit: $?\")",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run *)",
      "Bash(go mod *)",
      "Bash(go fmt *)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "mcp__qmd__search",
      "mcp__qmd__multi_get",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:meigen-ai.github.io)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledMcpjsonServers": [
    "qmd",
    "smart-connections"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-vault-check.sh"
          }
        ]
      }
    ]
  }
}
